---
const results = [
  { name: "Dr. Tóth Károly", percent: 49, color: "#bc243c" },
  { name: "Raátz Adalbert", percent: 35, color: "#287ba6" },
  { name: "Kolompár Gézáné Terike", percent: 16, color: "#32834c" },
];
const scaleMax = 50;
---

<figure class="election-chart" aria-labelledby="election-chart-title" aria-describedby="election-chart-note">
  <figcaption id="election-chart-title">
    <strong>A polgármester-választás eredményei</strong>
    <span>A szavazatok megoszlása (%) </span>
  </figcaption>
  <dl class="results">
    {results.map((result) => (
      <div class="result">
        <dt>{result.name}</dt>
        <dd>
          <div
            class:list={["bar", { "outside-label": result.percent < 20 }]}
            style={{ width: `${(result.percent / scaleMax) * 100}%`, backgroundColor: result.color }}
          >
            <span class="value">{result.percent}%</span>
          </div>
        </dd>
      </div>
    ))}
  </dl>
</figure>

<style>
  .election-chart {
    margin: 20px 0;
    text-align: left;
    color: #222;
    --plot-background: #eff6f9;
  }

  figcaption {
    padding: 0 5px 12px;
    line-height: 1.5;
  }

  figcaption strong,
  figcaption span {
    display: block;
  }

  figcaption span {
    color: #555;
    font-size: 0.9em;
  }

  .results {
    margin: 0;
    padding: 16px 38px 16px 12px;
    background: var(--plot-background);
    border-top: 1px solid #d5e4ec;
    border-bottom: 1px solid #d5e4ec;
  }

  .result {
    display: grid;
    grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }

  dt {
    text-align: right;
    font-weight: bold;
    overflow-wrap: anywhere;
    line-height: 1.3;
    padding: 6px 0;
  }

  dd {
    margin: 0;
    padding: 5px 0;
    border-left: 1px solid #c8dce7;
    background-image: repeating-linear-gradient(to right, transparent 0, transparent calc(20% - 1px), #fff calc(20% - 1px), #fff 20%);
  }

  .bar {
    position: relative;
    height: 36px;
  }

  .value {
    position: absolute;
    right: 7px;
    top: 0;
    line-height: 36px;
    font-size: 1.15em;
    font-weight: bold;
    color: #fff;
    white-space: nowrap;
  }

  .outside-label .value {
    left: calc(100% + 7px);
    right: auto;
    color: #222;
  }

  .election-chart p {
    margin: 8px 5px 0;
    padding: 0;
    font-size: 0.85em;
    line-height: 1.5;
    color: #555;
  }

  @media (max-width: 480px) {
    .result {
      gap: 8px;
    }

    .value {
      font-size: 1em;
      right: 4px;
    }
  }
</style>