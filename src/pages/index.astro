---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ParodyDisclaimer from "../components/ParodyDisclaimer.astro";

const home = await getEntry("pages", "fooldal");
if (!home) throw new Error("Missing src/content/pages/fooldal.md");
const { Content } = await render(home);
---

<BaseLayout current="/">
  <div class="post">
    <h2>{home.data.title}</h2>
    <div class="entry home"><Content /></div>
  </div>
  <ParodyDisclaimer />
</BaseLayout>
